<div class="lenda-chat sessao-msg">
  <h3><i class="fas fa-flag-checkered"></i> {{localize "LENDA.Sessao.Fim"}} — {{actor.name}}</h3>
  <ul>
    <li>{{localize "LENDA.Sessao.Eventos"}}: <strong>{{eventos}}</strong></li>
    <li>{{localize "LENDA.Sessao.Lacos"}}: <strong>{{lacos}}</strong></li>
    <li>{{localize "LENDA.Sessao.Participacao"}}: <strong>1</strong></li>
    {{#if reviravolta}}<li>{{localize "LENDA.Sessao.Reviravolta"}}: <strong>2</strong></li>{{/if}}
  </ul>
  <p>{{localize "LENDA.Sessao.Ganho"}}: <strong>+{{ganho}}</strong> · {{localize "LENDA.Karma"}}: <strong>{{karma}}</strong></p>
  {{#if avancosPossiveis}}<p class="dica">{{localize "LENDA.Sessao.AvancosPossiveis" n=avancosPossiveis}}</p>{{/if}}
  {{#if reviravolta}}<p class="dica">{{localize "LENDA.Sessao.NovoCaminho"}}</p>{{/if}}
</div>
