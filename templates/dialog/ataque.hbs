<div class="lenda-form">
  {{#if alvos}}<p class="alvos"><i class="fas fa-crosshairs"></i> {{localize "LENDA.Ataque.Alvos"}}: <strong>{{alvos}}</strong></p>
  {{else}}<p class="dica"><i class="fas fa-crosshairs"></i> {{localize "LENDA.Ataque.SemAlvos"}}</p>{{/if}}
  <div class="form-linha">
    <div class="form-group">
      <label>{{localize "LENDA.Ataque.Tipo"}}</label>
      <select name="tipo">
        {{#each tipos}}<option value="{{value}}" {{#if (lenda-eq value ../tipo)}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>{{localize "LENDA.Atributo.Nome"}}</label>
      <select name="atributo">
        {{#each atributos}}<option value="{{value}}" {{#if (lenda-eq value ../atributo)}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
  </div>
  <div class="form-linha">
    <div class="form-group">
      <label>{{localize "LENDA.Ataque.Arma"}}</label>
      <select name="arma">
        <option value="">{{localize "LENDA.Ataque.Desarmado"}}</option>
        {{#each armas}}<option value="{{value}}">{{label}}</option>{{/each}}
      </select>
    </div>
    <div class="form-group">
      <label data-tooltip="{{localize 'LENDA.Ataque.AtributoDanoHint'}}">{{localize "LENDA.Ataque.AtributoDano"}}</label>
      <select name="atributoDano">
        <option value="">—</option>
        <option value="agi">{{localize "LENDA.Atributo.agilidade"}}</option>
        <option value="raz">{{localize "LENDA.Atributo.razao"}}</option>
        <option value="ins">{{localize "LENDA.Atributo.instinto"}}</option>
        <option value="pre">{{localize "LENDA.Atributo.presenca"}}</option>
        <option value="von">{{localize "LENDA.Atributo.vontade"}}</option>
      </select>
    </div>
  </div>
  <div class="form-linha">
    <div class="form-group"><label>{{localize "LENDA.Teste.Vantagens"}}</label><input type="number" name="vantagens" value="0" min="0"></div>
    <div class="form-group"><label>{{localize "LENDA.Teste.Desvantagens"}}</label><input type="number" name="desvantagens" value="0" min="0"></div>
    <div class="form-group"><label>{{localize "LENDA.Teste.BonusExtra"}}</label><input type="number" name="bonusExtra" value="0"></div>
  </div>
  <div class="form-linha">
    <div class="form-group"><label>{{localize "LENDA.Teste.Sinc"}} <span class="max">(máx. {{sinc}})</span></label><input type="number" name="sinc" value="0" min="0" max="{{sinc}}"></div>
    <div class="form-group"><label data-tooltip="{{localize 'LENDA.Teste.TrocasHint'}}">{{localize "LENDA.Teste.Trocas"}}</label><input type="number" name="trocas" value="0" min="0"></div>
    <div class="form-group"><label>{{localize "LENDA.Ataque.DanoExtra"}}</label><input type="number" name="danoExtra" value="0"></div>
  </div>
  {{#if conceitoDisponivel}}<label class="caixa-opcao"><input type="checkbox" name="conceito"> {{localize "LENDA.Conceito"}} (+1d10)</label>{{/if}}
</div>
