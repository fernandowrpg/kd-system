    {
      "_id": "S3ywDELpMd1yzJpV",
      "name": "Zankouken",
      "type": "tecnica",
      "img": "systems/lenda-dragao-fogo/assets/icons/golpe.svg",
      "system": {
        "requisitos": "Agilidade 4, Shunpo",
