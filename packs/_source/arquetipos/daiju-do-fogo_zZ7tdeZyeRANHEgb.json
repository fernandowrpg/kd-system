    {
      "_id": "RUqKOCJeFwJ06y5Q",
      "name": "Músculos de Aço",
      "type": "tecnica",
      "img": "systems/lenda-dragao-fogo/assets/icons/shintai.svg",
      "system": {
        "requisitos": "",
